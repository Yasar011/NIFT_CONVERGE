# ---- Firebase (web config — public, safe in the browser) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=

# ---- Firebase Admin (server only — SECRET) ----
# base64 of the service-account JSON file
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---- Access ----
ALLOWED_EMAIL_DOMAIN=nift.ac.in
MAIN_ADMIN_EMAILS=

# ---- Cloudinary (server only — SECRET) ----
# Primary account; the fallback is used automatically if the primary fails.
CLOUDINARY_URL_PRIMARY=
CLOUDINARY_URL_FALLBACK=

# ---- Final selection (main admin) ----
FINAL_SELECT_PASSWORD_HASH=
